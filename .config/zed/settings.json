{
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "agent": {
    "dock": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "buffer_font_size": 13.0,
  "agent_servers": {
    "cursor": {
      "type": "registry"
    },
    "codex": {
      "default_config_options": {
        "model": "gpt-5.4",
      },
    },
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true,
  },
  "icon_theme": "Catppuccin Macchiato",
  "theme": "Catppuccin Macchiato",
  "vim_mode": true,
  "scrollbar": {
    "diagnostics": "all",
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "code_actions": false,
  },
  "buffer_font_family": "Berkeley Mono",
  "project_panel": {
    "dock": "right",
    "indent_size": 10,
  },
  "autosave": "on_focus_change",
  "max_tabs": 1,
  "relative_line_numbers": "enabled",
}
